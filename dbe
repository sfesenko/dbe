#!/usr/bin/env sh
set -eu

# Resolve the real location of this script, following symlinks so that a
# symlink placed in PATH still finds the JAR next to the real script.
SOURCE="$0"
while [ -L "$SOURCE" ]; do
  DIR=$(cd "$(dirname "$SOURCE")" && pwd)
  SOURCE=$(readlink "$SOURCE")
  case "$SOURCE" in
    /*) ;;
    *) SOURCE="$DIR/$SOURCE" ;;
  esac
done
SCRIPT_DIR=$(cd "$(dirname "$SOURCE")" && pwd)

# An explicit DBE_JAR wins; otherwise look for the JAR next to the script
# (source checkout target/ or an installed layout).
if [ -n "${DBE_JAR:-}" ]; then
  if [ ! -f "$DBE_JAR" ]; then
    echo "Error: DBE_JAR does not point to a file: $DBE_JAR" >&2
    exit 1
  fi
  JAR="$DBE_JAR"
else
  JAR=""
  for cand in \
    "$SCRIPT_DIR/target/dbe-1.0-SNAPSHOT.jar" \
    "$SCRIPT_DIR/dbe-1.0-SNAPSHOT.jar" \
    "$SCRIPT_DIR/dbe.jar" \
    "$SCRIPT_DIR/../lib/dbe.jar"; do
    if [ -f "$cand" ]; then
      JAR="$cand"
      break
    fi
  done
fi

if [ -z "$JAR" ]; then
  echo "Error: dbe JAR not found." >&2
  echo "  Set DBE_JAR=/path/to/dbe.jar, or place the jar next to this script." >&2
  exit 1
fi

if ! command -v java >/dev/null 2>&1; then
  echo "Error: 'java' not found on PATH." >&2
  exit 1
fi

exec java -jar "$JAR" "$@"
